DATABASE_URL=postgres://clench:clench@localhost:5432/clench

# Для разового исторического батча (Фаза 1) достаточно обычного RPC —
# getSignaturesForAddress/getTransaction не требуют Helius.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Нужен только для реалтайм-ingest через Yellowstone gRPC (Фаза 5).
HELIUS_API_KEY=

# Параметры прогона калибровки (scripts/run-calibration.ts, scripts/calibration-report.ts).
CALIBRATION_MINT=
CALIBRATION_CREATED_UNIX=
CALIBRATION_MINT_LABEL=
CALIBRATION_OUT=

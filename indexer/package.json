{
  "name": "@clench/indexer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "migrate": "tsx -e \"import('./src/db/pool.js').then(m => m.migrate()).then(() => process.exit(0))\"",
    "calibrate": "tsx scripts/run-calibration.ts",
    "calibrate:report": "tsx scripts/calibration-report.ts"
  },
  "dependencies": {
    "@solana/web3.js": "^1.95.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@typescript-eslint/eslint-plugin": "^7.16.0",
    "@typescript-eslint/parser": "^7.16.0",
    "eslint": "^8.57.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
